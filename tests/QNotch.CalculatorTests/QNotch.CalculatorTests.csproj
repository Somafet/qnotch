    <EmbeddedResource Include="../fixtures/calculator/hungarian-payroll-oracle-v1.json" LogicalName="Calc.HungarianPayrollOracle" />
    <EmbeddedResource Include="../fixtures/calculator/spec/payroll.md" LogicalName="Calc.PayrollSpec" />
    <EmbeddedResource Include="../fixtures/calculator/matrices-v1.json" LogicalName="Calc.MatrixOracle" />
