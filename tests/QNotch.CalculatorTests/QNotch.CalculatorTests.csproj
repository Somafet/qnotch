    <EmbeddedResource Include="../fixtures/calculator/time-intervals-v1.json" LogicalName="Calc.TimeFixtures" />
    <EmbeddedResource Include="../fixtures/calculator/irr-oracle-v1.json" LogicalName="Calc.IrrOracle" />
    <EmbeddedResource Include="../fixtures/calculator/payroll-oracle-v1.json" LogicalName="Calc.PayrollOracle" />
