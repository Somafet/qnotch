{
  "version": 1,
  "requirement": "N01/N02 exact real square-root arithmetic",
  "basis": "Principal nonnegative roots, product/quotient identities, conjugation and exact rational rounding boundaries. Calc output syntax/field limits are proposals.",
  "cases": [
    { "source": "sqrt(2)", "expected": "sqrt(2)" },
    { "source": "sqrt(8)", "expected": "2*sqrt(2)" },
    { "source": "sqrt(72)", "expected": "6*sqrt(2)" },
    { "source": "sqrt(1/2)", "expected": "0.5*sqrt(2)" },
    { "source": "sqrt(8/9)", "expected": "(2/3)*sqrt(2)" },
    { "source": "sqrt(0.08)", "expected": "0.2*sqrt(2)" },
    { "source": "sqrt(0)", "expected": "0" },
    { "source": "sqrt(81/16)", "expected": "2.25" },
    { "source": "sqrt(8)+sqrt(18)", "expected": "5*sqrt(2)" },
    { "source": "sqrt(2)+sqrt(3)", "expected": "sqrt(2) + sqrt(3)" },
    { "source": "sqrt(2)-sqrt(2)", "expected": "0" },
    { "source": "sqrt(2)*sqrt(8)", "expected": "4" },
    { "source": "sqrt(6)*sqrt(10)", "expected": "2*sqrt(15)" },
    { "source": "1/sqrt(2)", "expected": "0.5*sqrt(2)" },
    { "source": "1/(1+sqrt(2))", "expected": "-1 + sqrt(2)" },
    { "source": "1/(sqrt(2)+sqrt(3))", "expected": "-sqrt(2) + sqrt(3)" },
    { "source": "(1+sqrt(2)+sqrt(3))*(1/(1+sqrt(2)+sqrt(3)))", "expected": "1" },
    { "source": "(sqrt(2)+sqrt(3))^2", "expected": "5 + 2*sqrt(6)" },
    { "source": "sqrt(2)^-2", "expected": "0.5" },
    { "source": "2^0.5", "expected": "sqrt(2)" },
    { "source": "8^(3/2)", "expected": "16*sqrt(2)" },
    { "source": "sqrt(3+2*sqrt(2))", "expected": "1 + sqrt(2)" },
    { "source": "sqrt(3-2*sqrt(2))", "expected": "-1 + sqrt(2)" },
    { "source": "sqrt(5-2*sqrt(6))", "expected": "-sqrt(2) + sqrt(3)" },
    { "source": "abs(1-sqrt(2))", "expected": "-1 + sqrt(2)" },
    { "source": "100 + sqrt(2)%", "expected": "100 + sqrt(2)" },
    { "source": "double sqrt(2)%", "expected": "(2*sqrt(2))%" },
    { "source": "share(1,3)", "expected": "(100/3)%" },
    { "source": "(1+sqrt(2))%", "expected": "(1 + sqrt(2))%" },
    { "source": "sqrt(2) to 3 decimals", "expected": "1.414" },
    { "source": "-sqrt(2) to 3 decimals", "expected": "-1.414" },
    { "source": "sqrt(2) to nearest 0.5", "expected": "1.5" },
    { "source": "3 to nearest sqrt(2)", "expected": "2*sqrt(2)" },
    { "source": "sqrt(2)% to 2 decimals", "expected": "1.41%" },
    { "source": "sqrt(2) to 3 sig figs", "expected": "1.41" },
    { "source": "sqrt(2)/10000 to 3 sig figs", "expected": "0.000141" },
    { "source": "sqrt(2)*10000 to 3 sig figs", "expected": "14100" },
    { "source": "2.675+sqrt(2)-sqrt(2) to 2 decimals", "expected": "2.68" },
    { "source": "sqrt(2)\nsqrt(8)\nsum", "expected": "3*sqrt(2)" },
    { "source": "sqrt(2) #x\nsqrt(8) #x\naverage #x", "expected": "1.5*sqrt(2)" },
    { "source": "二倍 の sqrt(2)", "expected": "2*sqrt(2)" },
    { "source": "sqrt(2)保留3位小数", "expected": "1.414" }
  ]
}
