{
  "version": 1,
  "basis": "Exact ticks/seconds and independent wall-clock minute counts. Range, equal-endpoint, break and display conventions are Calc proposals. Times are unzoned clock readings, not dated instants.",
  "cases": [
    { "source": "9:15", "expected": "09:15" },
    { "source": "09:15:00", "expected": "09:15" },
    { "source": "09:15:00.125", "expected": "09:15:00.125" },
    { "source": "12:00 am", "expected": "00:00" },
    { "source": "12:00 PM", "expected": "12:00" },
    { "source": "9:15pm", "expected": "21:15" },
    { "source": "24:00", "expected": "(00:00 + 1 day)" },
    { "source": "09:15–17:40", "expected": "8 h 25 min" },
    { "source": "09:15 to 17:40", "expected": "8 h 25 min" },
    { "source": "from 09:15 to 17:40", "expected": "8 h 25 min" },
    { "source": "09:15—17:40 - 45 min", "expected": "7 h 40 min" },
    { "source": "from 09:15 to 17:40 - 45 min", "expected": "7 h 40 min" },
    { "source": "22:00–06:00", "expected": "8 h" },
    { "source": "23:45–00:15", "expected": "30 min" },
    { "source": "09:00–09:00", "expected": "0 s" },
    { "source": "00:00–24:00", "expected": "24 h" },
    { "source": "09:00–(09:00+1day)", "expected": "24 h" },
    { "source": "09:00–(10:00+2day)", "expected": "49 h" },
    { "source": "22:00–06:00 - 30 min", "expected": "7 h 30 min" },
    { "source": "22:00–06:00 - 8 h", "expected": "0 s" },
    { "source": "17:40 - 09:15", "expected": "8 h 25 min" },
    { "source": "09:15 - 17:40", "expected": "-(8 h 25 min)" },
    { "source": "00:00:00.1–00:00:01.2", "expected": "1.1 s" },
    { "source": "00:00:00.0000001–00:00:00.0000003", "expected": "0.0000002 s" },
    { "source": "23:59:59.9–00:00:00.1", "expected": "0.2 s" },
    { "source": "09:15+45min", "expected": "10:00" },
    { "source": "45min+09:15", "expected": "10:00" },
    { "source": "23:30+90min", "expected": "(01:00 + 1 day)" },
    { "source": "00:30-1h", "expected": "(23:30 - 1 day)" },
    { "source": "00:00+0.0000001s", "expected": "00:00:00.0000001" },
    { "source": "23:00+2day", "expected": "(23:00 + 2 day)" },
    { "source": "(09:15–17:40 -45min) in min", "expected": "460 min" },
    { "source": "(09:15–17:40 -45min) in h", "expected": "(23/3) h" },
    { "source": "(09:15–17:40 -45min) in h to 2 decimals", "expected": "7.67 h" },
    { "source": "(09:15–17:40 -45min) *20/hour to 2 decimals", "expected": "153.33" },
    { "source": "(09:00–10:30) *10 km/h", "expected": "15 km" },
    { "source": "20/hour", "expected": "20 h^-1" },
    { "source": "20 per hour", "expected": "20 h^-1" },
    { "source": "3 km per hour", "expected": "3 km/h" },
    { "source": "1 / h in s^-1", "expected": "(1/3600) s^-1" },
    { "source": "half (09:00–10:00)", "expected": "Unknown function: half", "error": true },
    { "source": "half of (09:00–10:00)", "expected": "30 min" },
    { "source": "(09:00–10:00)+10%", "expected": "1 h 6 min" },
    { "source": "(09:00–10:00)/2", "expected": "30 min" },
    { "source": "(09:00–10:00)*2", "expected": "2 h" },
    { "source": "start=22:00\nend=06:00\nfrom start to end -30min", "expected": "7 h 30 min" },
    { "source": "22:00\nL1–06:00\nprev-30min", "expected": "7 h 30 min" },
    { "source": "work(a,b)=from a to b\nwork(22:00,06:00)-30min", "expected": "7 h 30 min" },
    { "source": "shift(t,d)=t+d\nshift(23:30,90min)", "expected": "(01:00 + 1 day)" },
    { "source": "09:00–10:00 #x\n13:00–15:30 #x\nsum #x", "expected": "3 h 30 min" },
    { "source": "09:00–10:00 #x\n13:00–15:30 #x\naverage #x", "expected": "1 h 45 min" },
    { "source": "09:00–10:01 to nearest 5 min", "expected": "1 h" },
    { "source": "\"Shift\" 09:15–17:40 -45min", "expected": "7 h 40 min" },
    { "source": "Start 9:15", "expected": "09:15" }
  ]
}
