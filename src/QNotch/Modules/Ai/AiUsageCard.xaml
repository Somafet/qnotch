<UserControl x:Class="QNotch.Modules.Ai.AiUsageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:QNotch.Modules.Ai">
    <!-- DataContext: AiState. Headline window per enabled provider; unavailable providers say so instead of showing 0%. -->
    <UserControl.Resources>
        <ResourceDictionary Source="AiStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <ItemsControl ItemsSource="{Binding Providers}" VerticalAlignment="Top" Visibility="{Binding HasProviders, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ai:AiProviderItem}">
                    <StackPanel Margin="0,0,0,8" Background="Transparent" ToolTip="{Binding Tooltip}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HeadlineText}" FontWeight="SemiBold" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOk}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAccounts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox Style="{StaticResource AccountPicker}" Tag="Claude: " ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" DisplayMemberPath="Name"
                                          DropDownOpened="OnAccountsOpened" DropDownClosed="OnAccountsClosed"
                                          Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DockPanel>
                        <ai:UsageBar Percent="{Binding HeadlinePercent}" Margin="0,4,0,0" Visibility="{Binding IsOk, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No usage providers enabled.&#10;Turn them on in Settings." Style="{StaticResource Muted}" TextAlignment="Center"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoProviders, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
