<UserControl x:Class="QNotch.Modules.Ai.AiTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:QNotch.Modules.Ai"
             xmlns:theme="clr-namespace:QNotch.Theme">
    <!-- DataContext: AiState. 712 x 322 body, 19 DIP side inset. -->
    <UserControl.Resources>
        <ResourceDictionary Source="AiStyles.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="19,2,19,12">

            <!-- Usage -->
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static theme:Glyphs.Settings}" ToolTip="AI settings"
                        Command="{Binding OpenSettingsCommand}" Height="28" Width="28"/>
                <Button DockPanel.Dock="Right" Content="{x:Static theme:Glyphs.Refresh}" ToolTip="Refresh now" Command="{Binding RefreshCommand}" Height="28" Width="28" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdatedText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Usage" Style="{StaticResource Title}" VerticalAlignment="Center"/>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Providers}" Visibility="{Binding HasProviders, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ai:AiProviderItem}">
                        <Border Width="327" Margin="0,0,10,10" Padding="16,12" CornerRadius="14" BorderThickness="1"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" Background="{DynamicResource AccentSoftBrush}"
                                            Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Plan}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,1,8,0" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- Reading -->
                                <StackPanel Visibility="{Binding IsOk, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Windows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ai:AiWindowItem}">
                                                <StackPanel Margin="0,0,0,10" Background="Transparent" ToolTip="{Binding ResetTip}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom">
                                                            <Run Text="{Binding UsedText, Mode=OneWay}"/><Run Text=" used" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text="{Binding LeftText, Mode=OneWay, StringFormat='   {0}'}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Label, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/><Run Text="{Binding ResetText, Mode=OneWay, StringFormat='   {0}'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <ai:UsageBar Percent="{Binding UsedPercent}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Signed out, failed or unsupported: never a number -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static theme:Glyphs.Warning}" Style="{StaticResource Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <StackPanel Width="265">
                                        <TextBlock Text="Unavailable" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Checking..." Style="{StaticResource Muted}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,8,0,16" HorizontalAlignment="Center" Visibility="{Binding NoProviders, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="No usage providers enabled" Style="{StaticResource Title}" HorizontalAlignment="Center"/>
                <TextBlock Text="Turn on Claude Code or Codex in the AI settings." Style="{StaticResource Muted}" Margin="0,4,0,8" HorizontalAlignment="Center"/>
                <Button Content="Open settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Center" Padding="12,5" FontSize="12"/>
            </StackPanel>

            <!-- Apps -->
            <DockPanel Margin="0,6,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static theme:Glyphs.Refresh}" ToolTip="Scan for AI apps" Command="{Binding RescanCommand}" Height="28" Width="28"/>
                <TextBlock DockPanel.Dock="Right" Text="Alt+1 to Alt+6 launch the numbered apps" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Apps" Style="{StaticResource Title}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding HotkeyWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HotkeyWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppTileLarge}" Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="{Binding NoApps, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding AppsEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
