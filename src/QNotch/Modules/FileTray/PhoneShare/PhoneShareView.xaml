<UserControl x:Class="QNotch.Modules.FileTray.PhoneShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: PhoneShareState. Fills row 1 of the Files tab (674 x 262). Left: the files; right: start, or the code and transfers. -->
    <UserControl.Resources>
        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="15"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Files -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Height="24" Margin="2,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource Link}" Content="All" Click="OnAll" ToolTip="Select every file"
                            Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource Link}" Content="None" Click="OnNone" ToolTip="Receive only: share no files"
                            Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <Border CornerRadius="10" BorderThickness="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4">
                        <ItemsControl x:Name="ChoiceList" ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,4,10,4" ToolTip="{Binding Item.Path}" ToolTipService.InitialShowDelay="600">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="Check" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  AutomationProperties.Name="{Binding Item.Name}"/>
                                        <TextBlock x:Name="Doc" Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="14" Margin="2,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="Note" Text="{Binding Item.SizeText}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Item.IsFolder}" Value="True">
                                            <Setter TargetName="Check" Property="IsEnabled" Value="False"/>
                                            <Setter TargetName="Note" Property="Text" Value="Folder, not shared"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Item.IsMissing}" Value="True">
                                            <Setter TargetName="Check" Property="IsEnabled" Value="False"/>
                                            <Setter TargetName="Note" Property="Text" Value="Missing"/>
                                            <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <!-- While sharing, the list is the frozen set: no checkboxes. -->
                                        <DataTrigger Binding="{Binding DataContext.IsActive, ElementName=ChoiceList}" Value="True">
                                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="Doc" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Margin="16,0" VerticalAlignment="Center" TextAlignment="Center" Text="The tray is empty. You can still receive files from your phone.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Help}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChoices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Not sharing: explanation, network and Start -->
        <StackPanel Grid.Column="2" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Send files to your phone and back" Style="{StaticResource Title}" FontSize="13" Margin="0,3,0,0"/>
            <TextBlock Style="{StaticResource Help}" FontSize="12" Margin="0,6,0,0"
                       Text="Start sharing and scan the code with your phone's camera. Its browser can download the files on the left and send photos and files to Downloads\QNotch on this PC. No app or account needed."/>
            <DockPanel Margin="0,12,0,0" Visibility="{Binding HasManyAddresses, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Network" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" Width="60"/>
                <ComboBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding Address}" FontSize="12"
                          AutomationProperties.Name="Network address" ToolTip="The address your phone connects to. Pick the network your phone is on."/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource AccentButton}" Padding="14,6" Click="OnStart" IsEnabled="{Binding CanStart}" ToolTip="Start a sharing session">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}"/>
                        <TextBlock Text="Start sharing" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="250"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Help}" Margin="0,16,0,0"
                       Text="The phone must be on the same network as this PC (Ethernet on the PC is fine). Guest Wi-Fi often keeps devices apart. If Windows asks, allow QNotch on private networks. Sharing ends after 15 minutes."/>
            <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0"
                       Text="The connection is plain HTTP and not encrypted: others on the network could see what you transfer. The code only controls who can connect."/>
        </StackPanel>

        <!-- Sharing: code, link, time, transfers -->
        <Grid Grid.Column="2" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Width="164" Height="164" CornerRadius="12" Background="White" Padding="2" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
                    <Image Source="{Binding Qr}" Stretch="Uniform" RenderOptions.EdgeMode="Aliased" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           AutomationProperties.Name="QR code with the sharing link"/>
                </Border>
                <TextBlock Text="{Binding Url}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,8,0,0" FontSize="10"/>
                <Button Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnCopy" ToolTip="Copy the sharing link">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Copy link" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Height="24" Margin="0,0,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="+15 min" Click="OnExtend" VerticalAlignment="Center"
                            IsEnabled="{Binding CanExtend}" ToolTip="Keep sharing 15 minutes longer"/>
                    <TextBlock Text="{Binding TimeLeft}" Style="{StaticResource Title}" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,6,0,0"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Help}" Margin="0,6,0,0"
                           Text="Not connecting? Use the same network (no guest Wi-Fi) and allow QNotch in the Windows firewall. Plain HTTP: not encrypted."/>
                <Grid Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasTransfers, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Transfers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,4,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Grid.RowSpan="2" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="Show" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                                Content="&#xE838;" ToolTip="Show in folder" Click="OnReveal" Visibility="Collapsed" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Detail" Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="Bar" Grid.Row="1" Grid.Column="1" Value="{Binding Percent}" Maximum="100" Height="3"
                                                     VerticalAlignment="Bottom" Margin="0,0,0,-4" IsTabStop="False"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False"><Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsUpload}" Value="True"><Setter TargetName="Show" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SavedPath}" Value="{x:Null}"><Setter TargetName="Show" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="200"
                               Text="Transfers show up here. Received files are added to the tray.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Help}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTransfers}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
