<UserControl x:Class="QNotch.Modules.NoteGithub.NoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:QNotch.Core">
    <!-- DataContext: NoteGithubState. The TextBox binds straight to NoteText; NoteStore owns persistence. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBox x:Name="Box" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MaxLength="100000" FontSize="12" Padding="8,5" SpellCheck.IsEnabled="False"/>
            <TextBlock x:Name="Hint" Text="Jot something down" Style="{StaticResource Muted}" Margin="9,6,9,0" IsHitTestVisible="False"
                       VerticalAlignment="Top" FontSize="12"/>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="StatusGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Text" Value="&#xE73E;"/>
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoteStatus}" Value="{x:Static core:NoteStatus.Editing}">
                                <Setter Property="Text" Value="&#xE70F;"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NoteStatus}" Value="{x:Static core:NoteStatus.Failed}">
                                <Setter Property="Text" Value="&#xE7BA;"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Text" Value="Saved"/>
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoteStatus}" Value="{x:Static core:NoteStatus.Editing}">
                                <Setter Property="Text" Value="Editing"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NoteStatus}" Value="{x:Static core:NoteStatus.Failed}">
                                <Setter Property="Text" Value="Not saved"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Style="{StaticResource StatusGlyph}"/>
                <TextBlock Style="{StaticResource StatusText}"/>
            </StackPanel>
            <TextBlock x:Name="Meta" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
