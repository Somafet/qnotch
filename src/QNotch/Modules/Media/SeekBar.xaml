<UserControl x:Class="QNotch.Modules.Media.SeekBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="16" Focusable="False">
    <Grid Background="Transparent">
        <Border x:Name="Track" Height="4" CornerRadius="3" Background="{DynamicResource ControlHoverBrush}" VerticalAlignment="Center"/>
        <Border x:Name="Fill" Height="4" CornerRadius="3" Width="0" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
            <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbShift"/></Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
