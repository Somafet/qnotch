<UserControl x:Class="QNotch.Modules.Media.MediaTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QNotch.Modules.Media">
    <!-- Media tab (body 712 x 322, 19 DIP side inset). DataContext: MediaState. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MediaResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="19,0">
        <Grid x:Name="Live" VerticalAlignment="Center" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:ArtworkTile Width="220" Height="220" Radius="16" FontSize="56" VerticalAlignment="Center"/>

            <Grid Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Source app and session picker -->
                <DockPanel Height="32">
                    <ComboBox x:Name="Picker" DockPanel.Dock="Right" Width="190" Visibility="Collapsed" ItemTemplate="{StaticResource SessionItem}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AppName}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="  Paused" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist}" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Album}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,18,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                    <local:SeekBar x:Name="Seek" Progress="{Binding Progress}" IsSeekable="{Binding CanSeek}"/>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Caption}"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Style="{StaticResource TransportButton}" Content="&#xE892;" Width="44" Height="44" FontSize="18"
                            Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" ToolTip="Previous"/>
                    <Button Style="{StaticResource PlayButton}" Width="56" Height="56" FontSize="22" Margin="8,0"
                            Command="{Binding PlayPauseCommand}" IsEnabled="{Binding CanPlayPause}" ToolTip="Play or pause"/>
                    <Button Style="{StaticResource TransportButton}" Content="&#xE893;" Width="44" Height="44" FontSize="18"
                            Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" ToolTip="Next"/>
                </StackPanel>
            </Grid>
        </Grid>
        <ContentControl x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False"/>
    </Grid>
</UserControl>
