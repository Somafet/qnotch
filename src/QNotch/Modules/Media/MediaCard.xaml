<UserControl x:Class="QNotch.Modules.Media.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QNotch.Modules.Media">
    <!-- Home card body (2 columns wide). DataContext: MediaState. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MediaResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="Live">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <local:ArtworkTile Width="74" Height="74" Radius="10" FontSize="26" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Artist}" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                    <local:SeekBar x:Name="Seek" Progress="{Binding Progress}" IsSeekable="{Binding CanSeek}"/>
                    <DockPanel Margin="0,1,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Muted}"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="112">
                <ComboBox x:Name="Picker" Height="26" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"
                          ItemTemplate="{StaticResource SessionItem}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource TransportButton}" Content="&#xE892;" Width="32" Height="32" FontSize="13"
                            Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" ToolTip="Previous"/>
                    <Button Style="{StaticResource PlayButton}" Margin="2,0" Command="{Binding PlayPauseCommand}"
                            IsEnabled="{Binding CanPlayPause}" ToolTip="Play or pause"/>
                    <Button Style="{StaticResource TransportButton}" Content="&#xE893;" Width="32" Height="32" FontSize="13"
                            Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" ToolTip="Next"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <ContentControl x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False"/>
    </Grid>
</UserControl>
