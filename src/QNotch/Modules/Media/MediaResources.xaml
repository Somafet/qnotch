<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Media-only styles. Theme brushes are DynamicResource so theme and accent switch live. -->

    <!-- Previous / next: glyph button, size and glyph size come from Width/Height/FontSize -->
    <Style x:Key="TransportButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource IconFont}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" TextOptions.TextRenderingMode="Grayscale"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlPressedBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Play / pause: round accent button, glyph follows MediaState.IsPlaying -->
    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Content" Value="&#xE768;"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource IconFont}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{DynamicResource OnAccentBrush}" TextOptions.TextRenderingMode="Grayscale"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Fill" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Content" Value="&#xE769;"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="SessionItem">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
    </DataTemplate>
</ResourceDictionary>
