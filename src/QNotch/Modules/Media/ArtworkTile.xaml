<UserControl x:Class="QNotch.Modules.Media.ArtworkTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: MediaState. The music glyph shows while there is no artwork; FontSize sets the glyph size. -->
    <Grid>
        <Border x:Name="Frame" Background="{DynamicResource ControlHoverBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
            <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource IconFont}" Foreground="{DynamicResource TextTertiaryBrush}"
                       TextOptions.TextRenderingMode="Grayscale" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Artwork}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
        <Border x:Name="Art" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
            <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background>
        </Border>
    </Grid>
</UserControl>
