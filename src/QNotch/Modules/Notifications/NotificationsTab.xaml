<UserControl x:Class="QNotch.Modules.Notifications.NotificationsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QNotch.Modules.Notifications">
    <!-- DataContext: NotificationsState. Row = one Note, newest first; hover reveals dismiss. The list is virtualized (up to 500 rows). -->
    <UserControl.Resources>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GlyphTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxHeight" Value="34"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pending}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DismissButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ActionButton" DataType="{x:Type local:NoteAction}">
            <Button Content="{Binding Label}" Padding="10,4" FontSize="12" Margin="0,0,6,0" Click="OnAction"/>
        </DataTemplate>

        <DataTemplate x:Key="NoteRow" DataType="{x:Type local:Note}">
            <Border x:Name="Row" Style="{StaticResource RowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28" VerticalAlignment="Top">
                        <Border Style="{StaticResource GlyphTile}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource LevelGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="50"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionButton}" Margin="0,7,0,2" Focusable="False"
                                      Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MetaText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource DismissButton}" Content="&#xE711;" ToolTip="Dismiss" Width="26" Height="26"
                            Margin="8,0,0,0" VerticalAlignment="Top" Click="OnDismiss"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="19,2,19,0" Background="Transparent" MouseEnter="OnSeen">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Clear all" Padding="10,4" FontSize="12" ToolTip="Clear the history (notifications waiting for an answer stay)"
                    IsEnabled="{Binding CanClear}" Click="OnClear"/>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>

        <ItemsControl x:Name="List" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NoteRow}" Focusable="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                        <ItemsPresenter Margin="0,0,0,12"/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No notifications" Style="{StaticResource Title}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="Apps and scripts can post here with QNotch.exe notify. See Settings, Notifications." Style="{StaticResource Muted}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
