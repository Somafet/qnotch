<UserControl x:Class="QNotch.Modules.GameMode.GameBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False" FontSize="11">
    <!-- DataContext: AppState. Single line, no artwork, no animation. Segment visibility comes from GameModeState (user toggle AND data availability),
         so the view only binds: it repaints when a bound text actually changes. Minimum widths keep changing digits from resizing the bar. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock Text="{Binding Media.NowPlayingText, Mode=OneWay}" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   Visibility="{Binding GameMode.ShowMedia, Converter={StaticResource BoolToVis}}"/>
        <TextBlock VerticalAlignment="Center" MinWidth="44" Margin="0,0,12,0"
                   Visibility="{Binding GameMode.ShowCpu, Converter={StaticResource BoolToVis}}">
            <Run Text="CPU" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text=" "/><Run Text="{Binding Stats.CpuText, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock VerticalAlignment="Center" MinWidth="44" Margin="0,0,12,0"
                   Visibility="{Binding GameMode.ShowGpu, Converter={StaticResource BoolToVis}}">
            <Run Text="GPU" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text=" "/><Run Text="{Binding Stats.GpuText, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock VerticalAlignment="Center" MinWidth="96" Margin="0,0,12,0"
                   Visibility="{Binding GameMode.ShowRam, Converter={StaticResource BoolToVis}}">
            <Run Text="RAM" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text=" "/><Run Text="{Binding Stats.RamText, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock VerticalAlignment="Center" MinWidth="124" Margin="0,0,12,0"
                   Visibility="{Binding GameMode.ShowNet, Converter={StaticResource BoolToVis}}">
            <Run Text="&#x2193;" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text="{Binding Stats.NetDownText, Mode=OneWay}"/><Run Text="  "/><Run Text="&#x2191;" Foreground="{DynamicResource TextTertiaryBrush}"/><Run Text="{Binding Stats.NetUpText, Mode=OneWay}"/>
        </TextBlock>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                    Visibility="{Binding GameMode.ShowBattery, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Stats.BatteryGlyph, Mode=OneWay}" Style="{StaticResource Glyph}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="{Binding Stats.BatteryText, Mode=OneWay}" MinWidth="28" VerticalAlignment="Center"/>
        </StackPanel>
        <!-- Reserved: frame-time readout (needs a presentation hook, not in v1). Stays collapsed while GameModeState.ShowFps is false. -->
        <TextBlock Text="{Binding GameMode.FpsText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="52" Margin="0,0,12,0"
                   Visibility="{Binding GameMode.ShowFps, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{Binding Stats.Clock, Mode=OneWay}" FontWeight="SemiBold" MinWidth="34" VerticalAlignment="Center" Margin="0,0,12,0"
                   Visibility="{Binding GameMode.ShowClock, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
