<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package of the self-contained QNotch.exe. Build-Msix.ps1 fills in {{VERSION}} and stages the logos.
     Identity values come from Partner Center (QNotch, Product identity) and must match it exactly. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="Somafet.QNotch" Publisher="CN=6504AF97-FC5B-4A2D-8148-647FE98D5244" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>QNotch</DisplayName>
    <PublisherDisplayName>Somafet</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 10 2004, the oldest version the app supports (same as the winget manifest). -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="QNotch" Executable="QNotch.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="QNotch" Description="A small notch at the top of your desktop for music, system stats, files, clipboard history and coding agents."
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start with Windows. Off until the user turns it on in the welcome tour or Settings (Core/Autostart.cs). -->
        <desktop:Extension Category="windows.startupTask" Executable="QNotch.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="QNotchStartup" Enabled="false" DisplayName="QNotch" />
        </desktop:Extension>
        <!-- qnotch on the PATH: the CLI verbs, and a stable path for agent hooks (Core/AppPackage.cs). -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="QNotch.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="qnotch.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
