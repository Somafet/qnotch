<?xml version="1.0" encoding="utf-8"?>
<!-- WPF does not support trimming: never enable PublishTrimmed. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Keep ReadyToRun and bundle caches separate from the self-contained variant. -->
    <IntermediateOutputPath>obj\$(Configuration)\framework-dependent\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\framework-dependent\</OutputPath>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
