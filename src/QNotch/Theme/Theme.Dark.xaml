<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Every key here must also exist in Theme.Light.xaml. Always reference with DynamicResource. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0B0B0D"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#141418"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#101014"/>
    <SolidColorBrush x:Key="CardBrush" Color="#17171C"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1E1E24"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AD"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6F6F7B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CD98C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB74D"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF"/>
</ResourceDictionary>
