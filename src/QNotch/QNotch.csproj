<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>QNotch</RootNamespace>
    <AssemblyName>QNotch</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <!-- No tiered JIT: at a 5 s idle cadence methods take minutes to reach the tier-up threshold, so the background JIT kept
         re-compiling (about 50 ms CPU per tick, 10x the app's own work) and doubled the code in memory. Full JIT up front costs
         about 65 ms of startup; R2R framework code is used as is. -->
    <TieredCompilation>false</TieredCompilation>
    <!-- ObservableObject raises only PropertyChanged (nothing here listens to PropertyChanging). -->
    <MvvmToolkitEnableINotifyPropertyChangingSupport>false</MvvmToolkitEnableINotifyPropertyChangingSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
