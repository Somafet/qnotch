<!-- Dev tool: regenerates the on-disk document fixtures the Swift documents port must read and reproduce byte for byte.
     Never shipped and not part of QNotch.sln. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../QNotch.Calculator.Engine/QNotch.Calculator.Engine.csproj" />
  </ItemGroup>
</Project>
