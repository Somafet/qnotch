---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Demo from '../components/Demo.astro';
import Features from '../components/Features.astro';
import OpenSource from '../components/OpenSource.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import OsSwitch from '../components/OsSwitch.astro';
import InstallDialog from '../components/InstallDialog.astro';
import og from '../assets/og.png';
import { GH, DL, releases } from '../lib/releases';
import type { OS } from '../scripts/platform';

// One page at three addresses. / describes both apps behind the Windows/Mac switch; /windows/ and /mac/ each
// describe one, for people searching for that platform. On those two the switch links to the other page.
export function getStaticPaths() {
  return [
    { params: { platform: undefined } },
    { params: { platform: 'windows' }, props: { pin: 'win' } },
    { params: { platform: 'mac' }, props: { pin: 'mac' } },
  ];
}
const { pin } = Astro.props as { pin?: OS };
// Whether this page shows content for that platform. Pinned pages leave out the other one's.
const shows = (os: OS) => !pin || pin === os;
const OS_PAGE = { win: '/windows/', mac: '/mac/' } as const;

const { mac: MAC, winget: WINGET, scoop: SCOOP, chocolatey: CHOCOLATEY } = await releases();

const numbers = {
  win: [
    { v: '0.08%', l: 'of one core, idle' },
    { v: '42 MB', l: 'of memory, idle' },
    { v: '1 exe', l: 'native WPF, no web view' },
    { v: '0', l: 'disabled extensions loaded' },
  ],
  mac: [
    { v: '<0.01%', l: 'of one core, idle' },
    { v: '11 MB', l: 'of memory, idle' },
    { v: `${MAC.mb} MB`, l: 'download, native AppKit' },
    { v: '0', l: 'disabled extensions loaded' },
  ],
};

const keys = {
  win: [
    { k: ['Ctrl', 'Alt', 'N'], l: 'Open or close the panel' },
    { k: ['Ctrl', 'Alt', 'F'], l: 'Search' },
    { k: ['Ctrl', 'Alt', 'G'], l: 'Game mode: Auto, On, Off' },
    { k: ['Alt', '1-6'], l: 'Launch the AI app in that slot' },
    { k: ['Esc'], l: 'Close the panel' },
  ],
  mac: [
    { k: ['⌃', '⌥', 'N'], l: 'Open or close the panel' },
    { k: ['⌃', '⌥', 'F'], l: 'Search' },
    { k: ['⌃', '⌥', 'G'], l: 'Game mode: Automatic, On, Off' },
    { k: ['⌃', '⌥', '1-6'], l: 'Launch the AI app in that slot' },
    { k: ['Esc'], l: 'Close the panel' },
  ],
};

const privacy = {
  win: [
    { icon: 'shield', t: 'Local settings and notes', d: 'Settings, notes and logs live in %APPDATA%\\QNotch on your PC. You do not need an account.' },
    { icon: 'bolt', t: 'Tokens in Credential Manager', d: 'QNotch stores tokens in Windows Credential Manager, never in a file.' },
    { icon: 'copy', t: 'Clipboard history in memory', d: 'QNotch keeps clipboard history in memory unless you choose to save it.' },
    { icon: 'link', t: 'Online features and usage data', d: 'Online integrations are optional. Usage events include hashed account or installation identifiers, never notes, clipboard text or file contents.' },
  ],
  mac: [
    { icon: 'shield', t: 'Local settings and notes', d: 'Settings, notes and logs live in ~/Library/Application Support/QNotch.Mac. You do not need an account.' },
    { icon: 'bolt', t: 'Tokens in the Keychain', d: 'QNotch stores your GitHub and notification tokens in the macOS Keychain, never in a file.' },
    { icon: 'copy', t: 'Clipboard history in memory', d: 'QNotch keeps clipboard history in memory unless you choose to save it, and skips what password managers mark as concealed.' },
    { icon: 'link', t: 'Online features and usage data', d: 'Online integrations are optional. Usage events include hashed account or installation identifiers, never notes, clipboard text or file contents.' },
  ],
} as const;

// os: which version the answer is about. JSON-LD lists those the page shows, so questions stay distinct.
const faq: { q: string; a: string; os?: OS }[] = [
  { q: 'Is it free?', a: 'Yes. QNotch is free under the MIT license, on Windows and Mac. It needs no account or subscription. The source is on GitHub.' },
  { q: 'Do I need a laptop with a notch?', os: 'win', a: "No. Windows laptops don't have one, so QNotch draws its own: a small pill at the top center of the screen. It works the same on a desktop monitor." },
  { q: 'Is QNotch a Dynamic Island for Windows?', os: 'win', a: "In spirit, yes. Like the Dynamic Island on an iPhone, the pill stays small, shows live activity such as music and your coding agents, and opens up when you hover over it. QNotch is an independent app, not made by Apple." },
  { q: 'How is QNotch different from other Mac notch apps?', os: 'mac', a: 'It is free and MIT licensed, it shows your Claude Code and Codex sessions beside the notch, and the same app runs on Windows: a setup code moves your layout between the two.' },
  { q: 'Windows says "Windows protected your PC". Is that normal?', os: 'win', a: "Yep, for now. The exe isn't code-signed yet, so SmartScreen has no clue who I am. Click More info, then Run anyway. Or if you'd rather not run a random exe from the internet (fair), build it from source with the .NET 10 SDK." },
  { q: 'Which download do I need?', os: 'win', a: 'QNotch-self-contained.zip (80 MB) runs as is. QNotch.exe (27 MB) is smaller but needs the .NET 10 Desktop Runtime.' },
  { q: 'Does it work on Windows 10?', os: 'win', a: 'Yes. It needs Windows 10 version 2004 or newer, on x64.' },
  { q: 'Which Macs does it run on?', os: 'mac', a: 'Apple silicon Macs (M1 or newer) with macOS 13 Ventura or newer. There is no Intel build.' },
  { q: 'Is the Mac app signed?', os: 'mac', a: 'Yes. It is signed with a Developer ID and notarized by Apple, so it opens like any other app. Updates come through Sparkle, which installs only a copy signed the same way.' },
  { q: 'Does my Mac need a notch?', os: 'mac', a: 'No. On a Mac or an external display without one, QNotch is a floating pill under the menu bar. Drag it sideways and it snaps to the center or an edge, and remembers the spot for each display.' },
  { q: 'Which permissions does it ask for?', os: 'mac', a: "None up front: no Accessibility, Screen Recording or notification permission. macOS asks once before QNotch controls Music or Spotify, and on macOS 15.4 or newer it may ask once whether QNotch can read the clipboard." },
  { q: 'Why does Now playing only show Music and Spotify?', os: 'mac', a: "macOS has no public way to read other apps' media sessions, and QNotch doesn't use private frameworks. Music and Spotify announce their tracks publicly and accept remote controls." },
  { q: 'Will it get in the way of my games?', os: 'win', a: 'No. When a game or fullscreen video is in front, Game mode shrinks the notch to one line of status, turns off hover and lets clicks pass straight through. Ctrl+Alt+G cycles Auto, On and Off.' },
  { q: 'Does it get in the way of full-screen games on a Mac?', os: 'mac', a: 'No. When a game is in front, the notch steps aside: the panel stays shut, clicks pass through and the wings show only the stats you pick. ⌃⌥G switches between Automatic, On and Off.' },
  { q: 'How does the Agents tab know what Claude Code and Codex are doing?', a: "One click in Settings, Agents adds a hook to Claude Code's settings.json or Codex's hooks.json, with a backup. Codex then asks you to trust it once. The hook talks to QNotch over a local pipe on Windows or a Unix socket on the Mac. Token counts come from the transcripts Claude Code already keeps on your computer." },
  { q: 'Where does the button on an agent take me?', a: 'It opens that session or thread in the Claude or Codex app. For a terminal session, it brings the terminal to the front.' },
  { q: 'Is the cost what I am billed?', a: "No. It's what those tokens would cost at API list prices. Pro and Max plans don't bill per token, so think of it as a 'look how much I'm getting out of my plan' number, not your bill." },
  { q: 'Can I put it on my other monitor?', os: 'win', a: 'Yes. Drag the pill onto it, or pick the monitor in Settings, General. It follows DPI changes without a restart.' },
  { q: 'Can I use it on an external display?', os: 'mac', a: 'Yes. Pick the main display or a specific one in Settings, General. If that display disconnects, QNotch moves to the main display and comes back when you reconnect it.' },
  { q: 'Can I move my settings between Windows and Mac?', a: 'Yes. Settings, General, Share your setup copies a code with your layout, features and preferences. Paste it into QNotch on the other computer, on either platform. Accounts, tokens and history never leave.' },
  { q: 'How do I add a feature of my own?', a: 'Open an issue with a sentence on what it does and where it shows, then build it in its own folder: src/QNotch/Modules on Windows, src/QNotch.Mac/Sources/QNotchMac/Modules on the Mac. The contributing guide walks through it.' },
];

const shownFaq = faq.filter(f => !f.os || shows(f.os));

// The first thing /windows/ and /mac/ say after the demo: what QNotch is there, in plain sentences.
type Fact = { t: string; d: string; code?: string[]; href?: string };
const about: Record<OS, { eyebrow: string; h: string; p: string[]; facts: Fact[] }> = {
  win: {
    eyebrow: 'QNotch for Windows',
    h: 'A Dynamic Island-style notch for Windows 11 and 10.',
    p: [
      "Windows doesn't have a notch, so QNotch adds one: a small pill at the top center of your screen, like the notch apps on a MacBook or the Dynamic Island on an iPhone. It shows what's playing, your system stats, the weather and your Claude Code and Codex sessions. Hover over it and a panel opens with clipboard history, a file tray, notes, search and more.",
      "It's a native WPF app in a single exe, not a web view, and uses about 42 MB of memory and 0.08% of one core while idle. When a game or fullscreen video is in front, Game mode shrinks it to one line of status and lets clicks pass straight through.",
    ],
    facts: [
      { t: 'Runs on', d: 'Windows 11, and Windows 10 version 2004 or newer, on x64.' },
      { t: 'Download', d: 'QNotch.exe (27 MB) with the .NET 10 Desktop Runtime, or the 80 MB self-contained ZIP.' },
      ...(WINGET ? [{ t: 'winget', d: 'Built into Windows 10 and 11.', code: ['winget install Somafet.QNotch'] }] : []),
      ...(SCOOP ? [{ t: 'Scoop', d: 'From the QNotch bucket.', code: ['scoop bucket add qnotch https://github.com/Somafet/scoop-bucket', 'scoop install qnotch/qnotch'] }] : []),
      ...(CHOCOLATEY ? [{ t: 'Chocolatey', d: 'From an administrator terminal.', code: ['choco install qnotch'] }] : []),
      { t: 'Price', d: 'Free and open source under the MIT license. No account.' },
      { t: 'Also on', d: 'Mac, as a native app for Apple silicon.', href: OS_PAGE.mac },
    ],
  },
  mac: {
    eyebrow: 'QNotch for Mac',
    h: 'A free, open source notch app for your MacBook.',
    p: [
      "QNotch puts the space around your MacBook's notch to work. The wings beside the camera show what's playing in Music or Spotify, your system stats, the weather and your Claude Code and Codex sessions. Hover over the notch and a panel opens with clipboard history, a file tray, notes, search and more.",
      "It's native Swift and AppKit, signed and notarized by Apple, and uses about 11 MB of memory while idle. No notch? On other Macs and on external displays it floats as a pill under the menu bar.",
    ],
    facts: [
      { t: 'Runs on', d: 'Apple silicon Macs (M1 or newer) with macOS 13 Ventura or newer.' },
      { t: 'Download', d: `QNotch-macos-arm64.dmg, ${MAC.mb} MB, signed with a Developer ID and notarized.` },
      { t: 'Updates', d: 'Built in, through Sparkle.' },
      { t: 'Permissions', d: 'None up front. macOS asks once before QNotch controls Music or Spotify.' },
      { t: 'Price', d: 'Free and open source under the MIT license. No account.' },
      { t: 'Also on', d: 'Windows 11 and 10, as a native WPF app.', href: OS_PAGE.win },
    ],
  },
};

// Titles and descriptions say what people search for: a notch for Windows, a notch app for a MacBook.
const pages = {
  hub: {
    title: 'QNotch: a notch for Windows 11 and macOS',
    description: 'QNotch puts music, system stats and your coding agents at the top of your screen. Free and open source for Windows and Mac.',
  },
  win: {
    title: 'Notch for Windows: a free Dynamic Island-style app · QNotch',
    description: 'A free, open source notch for Windows 11 and 10, like a Dynamic Island: music, system stats, clipboard history and your coding agents at the top of the screen.',
  },
  mac: {
    title: 'MacBook notch app, free and open source · QNotch',
    description: 'A free, open source notch app for MacBook: music, system stats, clipboard history and your Claude Code and Codex sessions in the wings beside the notch.',
  },
};
const { title, description } = pages[pin ?? 'hub'];
const site = Astro.site!.href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const author = { '@type': 'Person', name: 'Soma Somorjai', url: 'https://github.com/Somafet' };

// Structured data for search engines: the app, the site and the FAQ below
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: 'QNotch',
      description: pages.hub.description,
      inLanguage: 'en',
      publisher: author,
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}#app`,
      name: 'QNotch',
      description: pages.hub.description,
      url: site,
      image: new URL(og.src, site).href,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Windows 10 version 2004 or newer, Windows 11 (x64); macOS 13 or newer (Apple silicon)',
      downloadUrl: [DL, MAC.url],
      installUrl: [DL, MAC.url],
      softwareHelp: `${GH}#readme`,
      license: 'https://opensource.org/licenses/MIT',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author,
      sameAs: [GH],
    },
    ...(pin ? [{
      '@type': 'WebPage',
      '@id': url,
      url,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${site}#website` },
      about: { '@id': `${site}#app` },
    }] : []),
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: shownFaq.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base {title} {description} os={pin}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <header class="nav">
    <div class="wrap nav-in">
      <a class="logo" href="#top" aria-label="QNotch home"><span class="logo-mark"><i></i></span>QNotch</a>
      <nav class="nav-links" aria-label="Sections">
        <a href="#demo">Demo</a>
        <a href="#features">Features</a>
        <a href="#open-source">Open source</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="nav-cta">
        <ThemeSwitch />
        <a class="gh-link" href={GH} aria-label="QNotch on GitHub"><Icon name="github" /></a>
        <a class="btn btn-primary btn-sm os-win" href={DL}><Icon name="download" />Download</a>
        <a class="btn btn-primary btn-sm os-mac" href={MAC.url}><Icon name="download" />Download</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap center">
        <a class="badge" href={GH}><span class="badge-dot"></span>Free and open source<span class="sep">·</span>MIT</a>
        <h1>
          {shows('win') && (pin
            ? <span class="os-win">A <span class="grad">notch</span> for<br />Windows 11 and 10.</span>
            : <span class="os-win">A <span class="grad">notch</span> for<br />your Windows desktop.</span>)}
          {shows('mac') && (pin
            ? <span class="os-mac">Put your MacBook's<br /><span class="grad">notch</span> to work.</span>
            : <span class="os-mac">Put your Mac's<br /><span class="grad">notch</span> to work.</span>)}
        </h1>
        {shows('win') && <p class="lead hero-lead os-win">Your music, system stats and coding agents in a little pill at the top of your screen. Hover over it and you get clipboard history, files and quite a bit more.</p>}
        {shows('mac') && <p class="lead hero-lead os-mac">Your music, system stats and coding agents in the wings beside the notch. Hover over it and you get clipboard history, files and quite a bit more.</p>}
        <div class="hero-os"><OsSwitch links={pin && OS_PAGE} /></div>
        <div class="hero-cta">
          {shows('win') && <a class="btn btn-primary os-win" href={DL}><Icon name="windows" />Download for Windows</a>}
          {shows('mac') && <a class="btn btn-primary os-mac" href={MAC.url}><Icon name="apple" />Download for Mac</a>}
          <a class="btn btn-ghost" href={GH}><Icon name="github" />Star on GitHub</a>
        </div>
        {shows('win') && <p class="fine os-win">Free, no account · Windows 10 2004 or newer, x64 · 27 MB · <a class="inline" href={DL} data-install-open>Other ways to install</a></p>}
        {shows('mac') && <p class="fine os-mac">Free, no account · macOS 13 or newer, Apple silicon · {MAC.mb} MB · No notch? It floats under the menu bar.</p>}
      </div>
      <div class="wrap demo-wrap">
        <Demo />
      </div>
    </section>

    {pin && (
      <section class="about" id="about">
        <div class="wrap about-grid">
          <div>
            <span class="eyebrow">{about[pin].eyebrow}</span>
            <h2 class="h2-sm">{about[pin].h}</h2>
            {about[pin].p.map(p => <p class="lead">{p}</p>)}
          </div>
          <dl class="facts">
            {about[pin].facts.map(f => (
              <div>
                <dt>{f.t}</dt>
                <dd>
                  {f.href ? <a class="inline" href={f.href}>{f.d}</a> : f.d}
                  {f.code?.map(c => <code>{c}</code>)}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <section class="numbers-sec">
      <div class="wrap">
        {shows('win') && <div class="numbers-head os-win">
          <h2 class="h2-sm">42 MB of memory while idle.</h2>
          <p>Measured on Windows 11 with the panel closed. It's native WPF, not a browser in a trench coat.</p>
        </div>}
        {shows('mac') && <div class="numbers-head os-mac">
          <h2 class="h2-sm">11 MB of memory while idle.</h2>
          <p>Activity Monitor's Memory column on a MacBook Air (M2), every feature on, panel closed. It's native Swift and AppKit, not a browser in a trench coat.</p>
        </div>}
        {(['win', 'mac'] as const).filter(shows).map(os => (
          <ul class={`numbers os-${os}`}>
            {numbers[os].map(n => <li><b>{n.v}</b><span>{n.l}</span></li>)}
          </ul>
        ))}
      </div>
    </section>

    <Features />

    <section class="keys-sec">
      <div class="wrap keys-grid">
        <div>
          <span class="eyebrow">Hotkeys</span>
          <h2 class="h2-sm">Open the panel with a shortcut.</h2>
          <p class="lead">Use these shortcuts from any app. Change them in Settings, Hotkeys, or try them in the demo above.</p>
        </div>
        {(['win', 'mac'] as const).filter(shows).map(os => (
          <ul class={`keys os-${os}`}>
            {keys[os].map(r => (
              <li><span class="kk">{r.k.map(k => <kbd>{k}</kbd>)}</span><span>{r.l}</span></li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <OpenSource gh={GH} />

    <section class="privacy">
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">Privacy</span>
          <h2>Your content stays on your device.</h2>
          <p class="lead">Your content stays local. QNotch shares usage actions with PostHog by default, without your content. Turn off Share usage data in Settings, General or set QNOTCH_TELEMETRY_ENABLED=false. The <a class="inline" href="/privacy">privacy policy</a> has the details.</p>
        </div>
        {(['win', 'mac'] as const).filter(shows).map(os => (
          <ul class={`priv os-${os}`}>
            {privacy[os].map(p => <li class="card"><Icon name={p.icon} /><b>{p.t}</b><p>{p.d}</p></li>)}
          </ul>
        ))}
      </div>
    </section>

    <section class="faq-sec" id="faq">
      <div class="wrap faq-grid">
        <div>
          <span class="eyebrow">Questions</span>
          <h2 class="h2-sm">Common questions.</h2>
          <p class="lead">For other questions, <a class="inline" href={`${GH}/issues`}>ask on GitHub</a>.</p>
        </div>
        <div class="faq">
          {shownFaq.map(f => (
            <details class={f.os && `os-${f.os}`}>
              <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final">
      <div class="wrap center">
        <div class="final-pill" aria-hidden="true"><span></span></div>
        {shows('win') && <h2 class="os-win">Try QNotch on<br />your desktop.</h2>}
        {shows('mac') && <h2 class="os-mac">Try QNotch on<br />your Mac.</h2>}
        {shows('win') && <p class="lead final-lead os-win">I saw a really nice notch app on Reddit, but it was Mac only. Well, I'm on Windows. So I built one.</p>}
        {shows('mac') && <p class="lead final-lead os-mac">I built QNotch for Windows because the nice notch apps were Mac only. Then I wanted it on my MacBook too, so I rebuilt it natively in Swift.</p>}
        <div class="hero-cta">
          {shows('win') && <a class="btn btn-primary os-win" href={DL}><Icon name="windows" />Download for Windows</a>}
          {shows('mac') && <a class="btn btn-primary os-mac" href={MAC.url}><Icon name="apple" />Download for Mac</a>}
          <a class="btn btn-ghost" href={GH}><Icon name="github" />View the source</a>
        </div>
        {/* On / these switch the page in place; on /windows/ and /mac/ they go to the other page. */}
        <p class="fine">Free and open source · MIT license · {shows('win') && <><a class="inline os-win" href={DL} data-install-open>Other ways to install</a><span class="os-win"> · </span><a class="inline os-win" href={OS_PAGE.mac} data-os-link={pin ? undefined : 'mac'}>Also on Mac</a></>}{shows('mac') && <a class="inline os-mac" href={OS_PAGE.win} data-os-link={pin ? undefined : 'win'}>Also on Windows</a>}</p>
      </div>
    </section>
  </main>

  <InstallDialog gh={GH} winget={WINGET} scoop={SCOOP} chocolatey={CHOCOLATEY} />

  <footer class="foot">
    <div class="wrap foot-in">
      <span class="logo small"><span class="logo-mark"><i></i></span>QNotch</span>
      <nav aria-label="Footer">
        <a href={OS_PAGE.win}>For Windows</a>
        <a href={OS_PAGE.mac}>For Mac</a>
        <a href={GH}>GitHub</a>
        <a href={`${GH}/releases`}>Releases</a>
        <a href={`${GH}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        <a href={`${GH}/blob/main/SECURITY.md`}>Security</a>
        <a href="/privacy">Privacy</a>
        <a href={`${GH}/blob/main/LICENSE`}>MIT license</a>
        <ThemeSwitch />
      </nav>
    </div>
  </footer>
</Base>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(1.4) blur(16px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .nav-in {
    display: flex;
    align-items: center;
    height: 64px;
    gap: 24px;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 15px;
    color: var(--ink-2);
  }

  .nav-links a:hover { color: var(--ink); }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .gh-link {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-2);
  }

  .gh-link:hover { color: var(--ink); background: var(--bg-2); }
  .gh-link :global(.i) { width: 20px; height: 20px; }

  .hero { padding-top: clamp(48px, 8vw, 96px); padding-bottom: clamp(64px, 9vw, 120px); }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 14px;
