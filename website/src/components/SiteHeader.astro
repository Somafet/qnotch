---
import Icon from './Icon.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import StoreLogo from './StoreLogo.astro';
import { GH, STORE, releases } from '../lib/releases';

// home: on the landing page the section links scroll in place; everywhere else they go back to it.
interface Props { home?: boolean }
const { home = false } = Astro.props;
const at = (hash: string) => (home ? hash : `/${hash}`);
const { mac: MAC } = await releases();
const path = Astro.url.pathname;
const here = (p: string) => (path.startsWith(p) ? 'page' : undefined);
---
<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href={home ? '#top' : '/'} aria-label="QNotch home"><span class="logo-mark"><i></i></span>QNotch</a>
    <nav class="nav-links" aria-label="Site">
      <a href={at('#demo')}>Demo</a>
      <a href={at('#features')}>Features</a>
      <a href="/guides/" aria-current={here('/guides/')}>Guides</a>
      <a href="/developers/" aria-current={here('/developers/')}>Developers</a>
      <a href={at('#faq')}>FAQ</a>
    </nav>
    <div class="nav-cta">
      <ThemeSwitch />
      <a class="gh-link" href={GH} aria-label="QNotch on GitHub"><Icon name="github" /></a>
      <a class="btn btn-primary btn-sm os-win" href={STORE}><StoreLogo class="sm" />Get</a>
      <a class="btn btn-primary btn-sm os-mac" href={MAC.url}><Icon name="download" />Download</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(1.4) blur(16px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
  }

  .nav-in {
    display: flex;
    align-items: center;
    height: 64px;
    gap: 24px;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin-inline: auto;
    font-size: 15px;
    color: var(--ink-2);
  }

  .nav-links a:hover,
  .nav-links a[aria-current] { color: var(--ink); }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .gh-link {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-2);
  }

  .gh-link:hover { color: var(--ink); background: var(--bg-2); }
  .gh-link :global(.i) { width: 20px; height: 20px; }
  .btn :global(.store-logo.sm) { width: 20px; height: 20px; }

  @media (max-width: 820px) {
    .nav-links { display: none; }
    .nav-cta { margin-left: auto; }
  }

  @media (max-width: 560px) {
    .nav-in { gap: 8px; }
    .gh-link { display: none; }
  }
</style>
