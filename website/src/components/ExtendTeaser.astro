---
import Icon from './Icon.astro';

// The landing page's short version of /developers/, where OpenSource.astro has the code, the source layout
// and the steps to contribute.
interface Props { gh: string }
const { gh } = Astro.props;

const slots = [
  { icon: 'grid', name: 'Cards', where: 'A tile on the Home grid' },
  { icon: 'tabs', name: 'Tabs', where: 'A page in the panel' },
  { icon: 'pill', name: 'Segments', where: 'The pill, the glance strip, the game bar', mac: 'The wings beside the notch' },
  { icon: 'search', name: 'Search sources', where: 'Results in the one search box' },
  { icon: 'sliders', name: 'Settings', where: 'Its own settings page' },
] as const;
---
<section class="ext" id="open-source">
  <div class="wrap">
    <div class="ext-head">
      <div>
        <span class="eyebrow">Open source · MIT</span>
        <h2>Add your own extension.</h2>
      </div>
      <div class="ext-side">
        <p class="lead os-win">QNotch is a shell and sixteen extensions, each in one folder. An extension you turn off is never loaded. Yours can show up in five places.</p>
        <p class="lead os-mac">QNotch is a shell and fifteen extensions, each in one folder. An extension you turn off stops right away. Yours can show up in five places.</p>
        <div class="links">
          <a class="btn btn-light btn-sm" href="/developers/">Build an extension <Icon name="arrow" /></a>
          <a class="btn btn-line btn-sm" href={gh}><Icon name="github" />View the source</a>
        </div>
      </div>
    </div>
    <ul class="slots">
      {slots.map(s => (
        <li><Icon name={s.icon} /><b>{s.name}</b>{'mac' in s ? <><span class="os-win">{s.where}</span><span class="os-mac">{s.mac}</span></> : <span>{s.where}</span>}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ext {
    --o-bg: #0b0b0d;
    --o-ink: #f4f4f7;
    --o-ink-2: #a1a1ad;
    --o-line: rgba(255, 255, 255, 0.09);
    --o-card: #131317;
    padding-block: clamp(56px, 7vw, 88px);
    background:
      radial-gradient(60% 50% at 80% 0%, rgba(91, 157, 255, 0.12), transparent 70%),
      var(--o-bg);
    color: var(--o-ink);
    border-block: 1px solid var(--o-line);
  }

  .eyebrow { color: #6ea8ff; }
  .lead { color: var(--o-ink-2); }
  h2 { font-size: clamp(32px, 4.2vw, 48px); }

  .ext-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 48px;
    align-items: end;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .btn-light { background: #f4f4f7; color: #0b0b0d; }
  .btn-line { border: 1px solid rgba(255, 255, 255, 0.2); color: var(--o-ink); }
  .btn-line:hover { border-color: rgba(255, 255, 255, 0.4); }

  .slots {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }

  .slots li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px;
    border-radius: 14px;
    background: var(--o-card);
    border: 1px solid var(--o-line);
  }

  .slots :global(.i) { width: 20px; height: 20px; color: #6ea8ff; margin-bottom: 10px; }
  .slots b { font-size: 15px; }
  .slots span { font-size: 13.5px; color: var(--o-ink-2); line-height: 1.4; }

  @media (max-width: 960px) {
    .ext-head { grid-template-columns: 1fr; align-items: start; }
    .slots { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .slots { grid-template-columns: 1fr; }
  }
</style>
