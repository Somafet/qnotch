---
// The Microsoft Store bag in color, for buttons that open the QNotch Store listing.
const { class: cls = '' } = Astro.props as { class?: string };
---
<svg class:list={['store-logo', cls]} viewBox="0 0 48 48" aria-hidden="true">
  <defs>
    <linearGradient id="store-bag" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a8af0" />
      <stop offset="1" stop-color="#1257b8" />
    </linearGradient>
    <linearGradient id="store-handle" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5fb4ff" />
      <stop offset="1" stop-color="#2a8af0" />
    </linearGradient>
  </defs>
  <path d="M16 13V11a8 8 0 0 1 16 0v2" fill="none" stroke="url(#store-handle)" stroke-width="3.5" stroke-linecap="round" />
  <rect x="5" y="13" width="38" height="31" rx="6" fill="url(#store-bag)" />
  <rect x="5" y="13" width="38" height="5" rx="2.5" fill="#5fb4ff" opacity=".55" />
  <rect x="15" y="21" width="8.5" height="8.5" fill="#f25022" />
  <rect x="24.5" y="21" width="8.5" height="8.5" fill="#7fba00" />
  <rect x="15" y="30.5" width="8.5" height="8.5" fill="#00a4ef" />
  <rect x="24.5" y="30.5" width="8.5" height="8.5" fill="#ffb900" />
</svg>
