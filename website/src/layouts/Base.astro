---
import '@fontsource-variable/inter';
import '../styles/global.css';
import og from '../assets/og.png';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
// Hashed file name, so caches and social crawlers pick up a new image right away
const image = new URL(og.src, Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QNotch" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={og.width} />
    <meta property="og:image:height" content={og.height} />
    <meta property="og:image:alt" content="The open QNotch panel slamming down from the top of the screen and splitting the headline: Windows 11 has a notch." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#f5f4f0" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('qnotch-theme'); } catch {}
        const theme = saved === 'light' || saved === 'dark'
          ? saved : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#0a0a0c' : '#f5f4f0';

        // Windows or Mac: a ?os= link, then this tab's earlier choice, then the visitor's OS. See scripts/platform.ts.
        let os = new URLSearchParams(location.search).get('os');
        os = os === 'mac' || os === 'macos' ? 'mac' : os === 'windows' || os === 'win' ? 'win' : null;
        if (!os) { try { os = sessionStorage.getItem('qnotch-os'); } catch {} }
        if (os !== 'mac' && os !== 'win') {
          const platform = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;
          os = /mac|iphone|ipad|ipod/i.test(platform) ? 'mac' : 'win';
        }
        document.documentElement.dataset.os = os;
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
